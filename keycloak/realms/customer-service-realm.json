{
  "realm": "customer-service",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "USER"
      },
      {
        "name": "ADMIN"
      }
    ]
  },
  "clients": [
    {
      "clientId": "customer-service",
      "name": "Customer Service",
      "enabled": true,
      "protocol": "openid-connect",
